# SublyAI — nginx reverse proxy (template)
#
# Install:
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/sublyai
#   sudo ln -s /etc/nginx/sites-available/sublyai /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# Get an HTTPS cert with certbot:
#   sudo apt install certbot python3-certbot-nginx
#   sudo certbot --nginx -d sublyai.example.com
#
# Replace sublyai.example.com with your domain.

# Optional: redirect HTTP -> HTTPS once certbot has obtained your cert.
server {
    listen 80;
    listen [::]:80;
    server_name sublyai.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name sublyai.example.com;

    # certbot fills these in for you when you run --nginx; placeholders shown:
    # ssl_certificate     /etc/letsencrypt/live/sublyai.example.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/sublyai.example.com/privkey.pem;
    # include             /etc/letsencrypt/options-ssl-nginx.conf;
    # ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    # Allow large uploads (matches MAX_UPLOAD_BYTES default of 1 GiB).
    client_max_body_size 1024m;

    # Generous timeouts for long Whisper jobs.
    proxy_read_timeout  900s;
    proxy_send_timeout  900s;
    send_timeout        900s;

    # Compress text responses; FileResponse for media is already efficient.
    gzip on;
    gzip_types text/plain text/css application/javascript application/json text/vtt;

    location / {
        proxy_pass         http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";
        proxy_buffering    off;
    }
}
